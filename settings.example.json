{
  "window": {
    "width": 900,
    "height": 600
  },
  "editor": {
    "font_size": 16
  },
  "viewer": {
    "remember_position": true
  },
  "workspace": {
    "sidebar_visible": true,
    "sidebar_width": 250
  },
  "shortcuts": {
    "new_file": ["Command+N"],
    "new_folder": ["Command+Shift+N"],
    "open": ["Command+O"],
    "save": ["Command+S"],
    "save_as": ["Command+Shift+S"],
    "close_tab": ["Command+W"],
    "undo": ["Command+Z"],
    "redo": ["Command+Shift+Z", "Command+Y"],
    "next_tab": ["Ctrl+Tab"],
    "previous_tab": ["Ctrl+Shift+Tab"],
    "toggle_sidebar": ["Command+B"],
    "cancel": ["Escape"],
    "reader_next_page": ["PageDown"],
    "reader_previous_page": ["PageUp"]
  }
}
